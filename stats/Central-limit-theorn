<script>
/* ── KaTeX 수식 렌더링 ── */
const formulas = {
  'f-clt-main':    'S_n = X_1 + X_2 + \\cdots + X_n \\;\\xrightarrow{\\;d\\;}\\; N\\!\\left(n\\mu,\\;n\\sigma^2\\right)',
  'f-xbar':        'S_n = X_1 + X_2 + \\cdots + X_n',
  'f-xbar-ev':     'E[S_n] = n\\mu',
  'f-xbar-var':    '\\text{Var}(S_n) = n\\sigma^2',
  'f-clt-formal':  '\\dfrac{S_n - n\\mu}{\\sqrt{n}\\,\\sigma} \\xrightarrow{\\;d\\;} N(0,\\,1) \\quad (n \\to \\infty)',
  'f-z-xbar':      'Z = \\dfrac{S_n - n\\mu}{\\sqrt{n}\\,\\sigma} \\sim N(0,1)',
  'f-clt-sum':     'S_n \\;\\xrightarrow{\\;d\\;}\\; N\\!\\left(n\\mu,\\; n\\sigma^2\\right)',
  'f-ex-dist':     '\\bar{X} \\sim N\\!\\left(50,\\; \\frac{8^2}{64}\\right) = N(50,\\;1)',
  'f-ex-z':        'Z = \\dfrac{\\bar{X} - 50}{1}',
  'f-ex-calc':     'P(\\bar{X} > 51) = P\\!\\left(Z > \\frac{51-50}{1}\\right) = P(Z > 1)',
  'f-ci':          '\\bar{X} \\pm 1.96 \\cdot \\dfrac{\\sigma}{\\sqrt{n}}',
  'f-clt-summary': 'S_n \\;\\xrightarrow{\\;d\\;}\\; N\\!\\left(n\\mu,\\;n\\sigma^2\\right)',
};

document.addEventListener('DOMContentLoaded', function() {
  Object.entries(formulas).forEach(([id, tex]) => {
    const el = document.getElementById(id);
    if (el) katex.render(tex, el, { throwOnError: false, displayMode: false });
  });
  drawConvCanvas();
  runSim();
});

/* ── 수렴 시각화 (페이지 3) ── */
function drawConvCanvas() {
  const canvas = document.getElementById('conv-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  canvas.width = canvas.offsetWidth * window.devicePixelRatio;
  canvas.height = 260 * window.devicePixelRatio;
  ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  const W = canvas.offsetWidth, H = 260;

  ctx.clearRect(0, 0, W, H);

  const configs = [
    { n: 1,  color: '#7c78c0', label: 'n = 1' },
    { n: 5,  color: '#0891b2', label: 'n = 5' },
    { n: 30, color: '#059669', label: 'n = 30' },
  ];

  const PAD = 40, plotW = W - PAD * 2, plotH = H - 60;
  const bins = 60;
  const TRIALS = 8000;

  configs.forEach(({ n, color, label }, ci) => {
    // 균등분포 U(0,1)에서 표본평균 시뮬레이션
    const means = [];
    for (let t = 0; t < TRIALS; t++) {
      let s = 0;
      for (let i = 0; i < n; i++) s += Math.random();
      means.push(s / n);
    }
    const hist = new Array(bins).fill(0);
    means.forEach(v => {
      const b = Math.min(bins - 1, Math.floor(v * bins));
      hist[b]++;
    });
    const maxH = Math.max(...hist);

    ctx.beginPath();
    ctx.strokeStyle = color;
    ctx.lineWidth = 2.5;
    ctx.globalAlpha = 0.85;
    for (let b = 0; b < bins; b++) {
      const x = PAD + (b / bins) * plotW;
      const y = H - 30 - (hist[b] / maxH) * plotH * 0.88;
      if (b === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();
    ctx.globalAlpha = 1;

    // 범례
    ctx.fillStyle = color;
    ctx.fillRect(PAD + ci * 120, 10, 18, 4);
    ctx.fillStyle = '#444';
    ctx.font = '13px Segoe UI, sans-serif';
    ctx.fillText(label, PAD + ci * 120 + 24, 18);
  });

  // 축
  ctx.strokeStyle = '#ddd';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(PAD, H - 30);
  ctx.lineTo(W - PAD, H - 30);
  ctx.stroke();

  ctx.fillStyle = '#aaa';
  ctx.font = '12px Segoe UI, sans-serif';
  ctx.fillText('0', PAD - 4, H - 14);
  ctx.fillText('0.5', W / 2 - 8, H - 14);
  ctx.fillText('1', W - PAD - 4, H - 14);
  ctx.fillText('표본평균 x̄', W / 2 - 30, H - 2);
}

/* ── 시뮬레이션 (페이지 4) ── */
function sample(dist) {
  switch (dist) {
    case 'uniform': return Math.random();
    case 'exp': return -Math.log(1 - Math.random());
    case 'binom': {
      let s = 0;
      for (let i = 0; i < 10; i++) if (Math.random() < 0.3) s++;
      return s;
    }
    case 'bimodal':
      return Math.random() < 0.5
        ? 0.2 + Math.random() * 0.2
        : 0.6 + Math.random() * 0.2;
    default: return Math.random();
  }
}

function updateSim() {
  document.getElementById('n-val').textContent = document.getElementById('n-slider').value;
}

function runSim() {
  const n = parseInt(document.getElementById('n-slider').value);
  const dist = document.getElementById('dist-select').value;
  updateSim();

  const TRIALS = 10000;
  const means = [];
  for (let t = 0; t < TRIALS; t++) {
    let s = 0;
    for (let i = 0; i < n; i++) s += sample(dist);
    means.push(s / n);
  }

  const mu = means.reduce((a, b) => a + b, 0) / TRIALS;
  const variance = means.reduce((a, b) => a + (b - mu) ** 2, 0) / TRIALS;
  const sd = Math.sqrt(variance);

  const canvas = document.getElementById('sim-canvas');
  const ctx = canvas.getContext('2d');
  canvas.width = canvas.offsetWidth * window.devicePixelRatio;
  canvas.height = 280 * window.devicePixelRatio;
  ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  const W = canvas.offsetWidth, H = 280;
  ctx.clearRect(0, 0, W, H);

  // 히스토그램
  const bins = 50;
  const minV = Math.min(...means), maxV = Math.max(...means);
  const range = maxV - minV || 1;
  const hist = new Array(bins).fill(0);
  means.forEach(v => {
    const b = Math.min(bins - 1, Math.floor(((v - minV) / range) * bins));
    hist[b]++;
  });
  const maxH = Math.max(...hist);

  const PAD = 44, plotW = W - PAD * 2, plotH = H - 60;
  const bw = plotW / bins;

  for (let b = 0; b < bins; b++) {
    const bh = (hist[b] / maxH) * plotH * 0.9;
    ctx.fillStyle = '#c4bfec';
    ctx.fillRect(PAD + b * bw, H - 30 - bh, bw - 1, bh);
  }

  // 정규 곡선 오버레이
  ctx.beginPath();
  ctx.strokeStyle = '#4338ca';
  ctx.lineWidth = 2.5;
  for (let px = 0; px <= plotW; px++) {
    const xv = minV + (px / plotW) * range;
    const z = (xv - mu) / (sd || 0.001);
    const density = Math.exp(-0.5 * z * z) / ((sd || 0.001) * Math.sqrt(2 * Math.PI));
    // scale to match histogram
    const scaledDensity = density * (TRIALS * range / bins);
    const py = H - 30 - (scaledDensity / maxH) * plotH * 0.9;
    if (px === 0) ctx.moveTo(PAD + px, py); else ctx.lineTo(PAD + px, py);
  }
  ctx.stroke();

  // 범례
  ctx.fillStyle = '#c4bfec';
  ctx.fillRect(PAD, 10, 14, 14);
  ctx.fillStyle = '#555';
  ctx.font = '13px Segoe UI, sans-serif';
  ctx.fillText('표본평균 분포', PAD + 20, 21);

  ctx.strokeStyle = '#4338ca';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(PAD + 150, 17);
  ctx.lineTo(PAD + 168, 17);
  ctx.stroke();
  ctx.fillStyle = '#555';
  ctx.fillText('정규분포 곡선', PAD + 174, 21);

  // 축
  ctx.strokeStyle = '#ddd';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(PAD, H - 30);
  ctx.lineTo(W - PAD, H - 30);
  ctx.stroke();

  ctx.fillStyle = '#aaa';
  ctx.font = '11px Segoe UI, sans-serif';
  ctx.fillText(minV.toFixed(2), PAD, H - 14);
  ctx.fillText(mu.toFixed(2), W / 2 - 12, H - 14);
  ctx.fillText(maxV.toFixed(2), W - PAD - 20, H - 14);

  // 통계 표시
  document.getElementById('sim-stats').innerHTML =
    `<strong>시뮬레이션 결과 (n = ${n}, ${TRIALS.toLocaleString()}회 반복):</strong><br>
    표본평균의 평균 = <strong>${mu.toFixed(4)}</strong> &nbsp;|&nbsp;
    표본평균의 표준편차 = <strong>${sd.toFixed(4)}</strong>
    &nbsp;(이론값 σ/√n = ${(getTheoSD(dist) / Math.sqrt(n)).toFixed(4)})`;
}

function getTheoSD(dist) {
  // 각 분포의 이론 표준편차
  switch (dist) {
    case 'uniform': return 1 / Math.sqrt(12);
    case 'exp': return 1;
    case 'binom': return Math.sqrt(10 * 0.3 * 0.7);
    case 'bimodal': return 0.22;
    default: return 1;
  }
}
</script>
