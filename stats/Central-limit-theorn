<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>중심극한정리 (Central Limit Theorem)</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Segoe UI', 'Apple SD Gothic Neo', sans-serif;
    background: #f0eff5;
    color: #1a1a1a;
    font-size: 18px;
    line-height: 1.7;
  }

  .page {
    background: #ffffff;
    max-width: 980px;
    margin: 0 auto 60px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 20px rgba(0,0,0,0.08);
  }

  .page-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 52px;
    background: #1e1b4b;
    color: #fff;
  }

  .page-number {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7c7ab8;
  }

  .page-title-header {
    font-size: 15px;
    font-weight: 400;
    color: #a8a6d8;
  }

  .page-body {
    padding: 52px 52px 60px;
  }

  .slide-title {
    font-size: 38px;
    font-weight: 700;
    color: #1e1b4b;
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .slide-subtitle {
    font-size: 20px;
    color: #666;
    margin-bottom: 36px;
    font-weight: 400;
  }

  .divider {
    height: 1px;
    background: #ebe9f4;
    margin-bottom: 36px;
  }

  /* ── 카드 ── */
  .card-row {
    display: grid;
    gap: 20px;
    margin-bottom: 24px;
  }
  .cols2 { grid-template-columns: 1fr 1fr; }
  .cols3 { grid-template-columns: 1fr 1fr 1fr; }

  .card {
    background: #f7f6fb;
    border: 1px solid #e0ddf0;
    border-radius: 12px;
    padding: 24px 26px;
  }

  .card-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9b97c8;
    margin-bottom: 10px;
  }

  .card-body {
    font-size: 18px;
    color: #444;
    line-height: 1.65;
  }

  .formula-box {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 16px 20px;
    margin-top: 14px;
    text-align: center;
    font-size: 20px;
    overflow-x: auto;
  }

  /* ── 하이라이트 ── */
  .hl-purple {
    background: #eeecff;
    border: 1px solid #b8b4f0;
    border-radius: 10px;
    padding: 18px 24px;
    color: #3730a3;
    font-size: 19px;
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .hl-blue {
    background: #eaf2ff;
    border: 1px solid #b0cfff;
    border-radius: 10px;
    padding: 18px 24px;
    color: #1a4fa0;
    font-size: 19px;
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .hl-green {
    background: #eafaf0;
    border: 1px solid #8fd4a8;
    border-radius: 10px;
    padding: 18px 24px;
    color: #1a6b3a;
    font-size: 19px;
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .hl-amber {
    background: #fff8e6;
    border: 1px solid #f0cc6e;
    border-radius: 10px;
    padding: 18px 24px;
    color: #7a5200;
    font-size: 19px;
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .hl-red {
    background: #fff0f0;
    border: 1px solid #f0aaaa;
    border-radius: 10px;
    padding: 18px 24px;
    color: #8b1a1a;
    font-size: 19px;
    line-height: 1.65;
    margin-bottom: 20px;
  }

  /* ── 흐름 노드 ── */
  .flow-row {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 16px;
    flex-wrap: nowrap;
  }

  .flow-node {
    flex: 1;
    text-align: center;
    background: #f0eefb;
    border: 1.5px solid #c4bfec;
    border-radius: 12px;
    padding: 16px 12px;
    font-size: 18px;
    font-weight: 700;
    color: #2d2880;
    line-height: 1.35;
  }

  .flow-node span {
    display: block;
    font-size: 14px;
    font-weight: 400;
    color: #7c78c0;
    margin-top: 4px;
  }

  .flow-node.gray {
    background: #f4f3f0;
    border-color: #ccc;
    color: #333;
  }
  .flow-node.gray span { color: #999; }

  .flow-node.green {
    background: #d6f5e3;
    border-color: #6dc994;
    color: #0d5c2e;
  }
  .flow-node.green span { color: #3a9960; }

  .flow-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 10px;
    flex-shrink: 0;
    gap: 2px;
  }

  .flow-arrow-label {
    font-size: 12px;
    color: #aaa;
    text-align: center;
    white-space: nowrap;
    line-height: 1.3;
  }

  .flow-arrow-sym {
    font-size: 26px;
    color: #bbb;
    line-height: 1;
  }

  /* ── TOC 바 ── */
  .toc-bar {
    max-width: 980px;
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid #d8d5ef;
    background: #fff;
  }

  .toc-item {
    flex: 1;
    text-align: center;
    padding: 12px 6px;
    font-size: 13px;
    color: #8884c0;
    font-weight: 500;
    border-right: 1px solid #eee;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s;
    line-height: 1.3;
  }

  .toc-item:last-child { border-right: none; }
  .toc-item:hover { background: #f0eefb; color: #3730a3; }

  .page-rule {
    max-width: 980px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    color: #9b97c8;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .page-rule::before, .page-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #d8d5ef;
  }

  .col-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9b97c8;
    margin-bottom: 10px;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  /* ── 조건 박스 ── */
  .condition-box {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
  }

  .condition-item {
    flex: 1;
    background: #f0eefb;
    border: 1px solid #c4bfec;
    border-radius: 10px;
    padding: 16px 18px;
    text-align: center;
  }

  .condition-num {
    font-size: 28px;
    font-weight: 700;
    color: #4338ca;
    line-height: 1;
    margin-bottom: 6px;
  }

  .condition-desc {
    font-size: 16px;
    color: #555;
    line-height: 1.5;
  }

  /* ── 큰 수식 강조 ── */
  .big-formula {
    background: #1e1b4b;
    border-radius: 14px;
    padding: 28px 32px;
    text-align: center;
    margin-bottom: 24px;
    overflow-x: auto;
    color: #ffffff;
  }

  .big-formula .katex,
  .big-formula .katex * {
    color: #ffffff !important;
  }

  /* ── 예시 테이블 ── */
  .ex-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 17px;
    margin-bottom: 20px;
  }

  .ex-table th {
    background: #1e1b4b;
    color: #d4d2f5;
    font-weight: 600;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
    letter-spacing: 0.05em;
  }

  .ex-table th:first-child { border-radius: 8px 0 0 0; }
  .ex-table th:last-child { border-radius: 0 8px 0 0; }

  .ex-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #ebe9f4;
    color: #333;
    vertical-align: top;
  }

  .ex-table tr:last-child td { border-bottom: none; }
  .ex-table tr:nth-child(even) td { background: #f7f6fb; }

  /* ── 비교 박스 ── */
  .compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 24px;
  }

  .compare-card {
    border-radius: 12px;
    padding: 22px 24px;
    border: 1.5px solid;
  }

  .compare-card.before {
    background: #fff8e6;
    border-color: #f0cc6e;
  }

  .compare-card.after {
    background: #eafaf0;
    border-color: #6dc994;
  }

  .compare-card-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .before .compare-card-title { color: #7a5200; }
  .after .compare-card-title { color: #1a6b3a; }

  .compare-card-body {
    font-size: 18px;
    line-height: 1.6;
  }

  .before .compare-card-body { color: #5a3c00; }
  .after .compare-card-body { color: #0d4d28; }

  /* ── 시각화 canvas ── */
  canvas {
    display: block;
    width: 100%;
    border-radius: 10px;
    border: 1px solid #e0ddf0;
    background: #fff;
  }

  .sim-controls {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .sim-label {
    font-size: 16px;
    color: #555;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sim-val {
    font-weight: 700;
    color: #3730a3;
    min-width: 32px;
    display: inline-block;
  }

  input[type=range] {
    accent-color: #4338ca;
    width: 140px;
  }

  .btn-run {
    background: #4338ca;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 10px 22px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-run:hover { background: #3730a3; }

  strong { font-weight: 700; }

  @media (max-width: 680px) {
    .cols2, .cols3, .two-col, .compare-grid { grid-template-columns: 1fr; }
    .condition-box { flex-direction: column; }
    .page-body { padding: 32px 24px 40px; }
    .page-header { padding: 14px 24px; }
    .slide-title { font-size: 28px; }
    .toc-item { font-size: 11px; padding: 10px 3px; }
  }
</style>
</head>
