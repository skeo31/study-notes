document.addEventListener('DOMContentLoaded', function() {
  const formulas = {
    'f-binom-pmf':      'P(X=k) = \\dbinom{n}{k} p^k (1-p)^{n-k}',
    'f-binom-mean':     'E[X] = np',
    'f-binom-var':      '\\text{Var}(X) = np(1-p)',
    'f-pois-pmf':       'P(X=k) = \\dfrac{e^{-\\lambda}\\,\\lambda^k}{k!}',
    'f-pois-mean':      'E[X] = \\text{Var}(X) = \\lambda',
    'f-pois2':          'P(X=k) = \\dfrac{e^{-\\lambda}\\,\\lambda^k}{k!}',
    'f-exp-pdf':        'f(t) = \\lambda\\, e^{-\\lambda t}, \\quad t \\geq 0',
    'f-memoryless-inline': 'P(T>s+t\\mid T>s)=P(T>t)',
    'f-dml':            '\\frac{X - np}{\\sqrt{np(1-p)}} \\xrightarrow{\\;d\\;} N(0,\\,1)',
    'f-clt':            '\\bar{X}_n = \\frac{X_1+\\cdots+X_n}{n} \\xrightarrow{\\;d\\;} N\\!\\left(\\mu,\\,\\frac{\\sigma^2}{n}\\right)',
    'f-norm-pdf':       'f(x) = \\dfrac{1}{\\sigma\\sqrt{2\\pi}}\\,e^{\\displaystyle-\\frac{(x-\\mu)^2}{2\\sigma^2}}',
    'f-std':            'Z = \\dfrac{X - \\mu}{\\sigma} \\sim N(0,\\,1)',
    'f-repr':           'X_1+X_2 \\sim N(\\mu_1{+}\\mu_2,\\;\\sigma_1^2{+}\\sigma_2^2)',
  };

  Object.entries(formulas).forEach(([id, tex]) => {
    const el = document.getElementById(id);
    if (el) {
      katex.render(tex, el, { throwOnError: false, displayMode: false });
    }
  });
});
