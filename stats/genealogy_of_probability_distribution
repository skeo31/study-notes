<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>확률분포의 계보</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Segoe UI', 'Apple SD Gothic Neo', sans-serif;
    background: #f5f4f0;
    color: #1a1a1a;
    font-size: 18px;
    line-height: 1.7;
  }

  /* ── 페이지 구분선 ── */
  .page {
    background: #ffffff;
    max-width: 960px;
    margin: 0 auto 60px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 16px rgba(0,0,0,0.08);
  }

  .page-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 48px;
    background: #1a1a1a;
    color: #ffffff;
  }

  .page-number {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #888;
  }

  .page-title {
    font-size: 15px;
    font-weight: 500;
    color: #ccc;
  }

  .page-body {
    padding: 52px 48px 56px;
  }

  /* ── 슬라이드 제목 ── */
  .slide-title {
    font-size: 36px;
    font-weight: 700;
    color: #111;
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .slide-subtitle {
    font-size: 20px;
    color: #555;
    margin-bottom: 36px;
    font-weight: 400;
  }

  .divider {
    height: 1px;
    background: #e8e6e0;
    margin-bottom: 36px;
  }

  /* ── 카드 ── */
  .card-row {
    display: grid;
    gap: 20px;
    margin-bottom: 24px;
  }
  .cols2 { grid-template-columns: 1fr 1fr; }
  .cols3 { grid-template-columns: 1fr 1fr 1fr; }

  .card {
    background: #f8f7f3;
    border: 1px solid #e0ddd5;
    border-radius: 12px;
    padding: 24px 26px;
  }

  .card-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 10px;
  }

  .card-title {
    font-size: 22px;
    font-weight: 700;
    color: #111;
    margin-bottom: 10px;
  }

  .card-body {
    font-size: 18px;
    color: #444;
    line-height: 1.65;
  }

  /* ── 수식 박스 ── */
  .formula-box {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 16px 20px;
    margin-top: 14px;
    text-align: center;
    font-size: 20px;
    overflow-x: auto;
  }

  /* ── 하이라이트 박스 ── */
  .hl-blue {
    background: #eaf2ff;
    border: 1px solid #b0cfff;
    border-radius: 10px;
    padding: 18px 22px;
    color: #1a4fa0;
    font-size: 19px;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .hl-green {
    background: #eafaf0;
    border: 1px solid #8fd4a8;
    border-radius: 10px;
    padding: 18px 22px;
    color: #1a6b3a;
    font-size: 19px;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .hl-amber {
    background: #fff8e6;
    border: 1px solid #f0cc6e;
    border-radius: 10px;
    padding: 18px 22px;
    color: #7a5200;
    font-size: 19px;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .hl-red {
    background: #fff0f0;
    border: 1px solid #f0aaaa;
    border-radius: 10px;
    padding: 18px 22px;
    color: #8b1a1a;
    font-size: 19px;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  /* ── 흐름도 ── */
  .flow-row {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 16px;
  }

  .flow-node {
    flex: 1;
    text-align: center;
    background: #f0eeea;
    border: 1.5px solid #ccc;
    border-radius: 12px;
    padding: 16px 12px;
    font-size: 19px;
    font-weight: 700;
    color: #222;
    line-height: 1.35;
  }

  .flow-node span {
    display: block;
    font-size: 14px;
    font-weight: 400;
    color: #888;
    margin-top: 4px;
  }

  .flow-node.blue {
    background: #dbeeff;
    border-color: #7ab4f5;
    color: #0d3d80;
  }
  .flow-node.blue span { color: #4a80c4; }

  .flow-node.green {
    background: #d6f5e3;
    border-color: #6dc994;
    color: #0d5c2e;
  }
  .flow-node.green span { color: #3a9960; }

  .flow-node.orange {
    background: #fff0d6;
    border-color: #f0b84a;
    color: #6b3e00;
  }
  .flow-node.orange span { color: #b06a00; }

  .flow-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 10px;
    flex-shrink: 0;
    gap: 2px;
  }

  .flow-arrow-label {
    font-size: 12px;
    color: #999;
    text-align: center;
    white-space: nowrap;
    line-height: 1.3;
  }

  .flow-arrow-sym {
    font-size: 28px;
    color: #bbb;
    line-height: 1;
  }

  .flow-down {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 80px;
    margin: 4px 0 4px;
  }

  .flow-down-line {
    width: 2px;
    height: 40px;
    background: #bbb;
    margin-left: 0;
  }

  .flow-down-label {
    font-size: 13px;
    color: #999;
    margin-left: 8px;
    margin-top: -28px;
  }

  /* ── 두 열 ── */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }

  .col-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 10px;
  }

  /* ── 리스트 ── */
  .list-item {
    display: flex;
    gap: 14px;
    font-size: 19px;
    color: #333;
    padding: 6px 0;
    line-height: 1.6;
  }

  .list-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #bbb;
    margin-top: 10px;
    flex-shrink: 0;
  }

  strong { font-weight: 700; }

  /* ── 페이지 구분 가로줄 (TOC 스타일) ── */
  .toc-bar {
    max-width: 960px;
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    gap: 0;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid #ddd;
    background: #fff;
  }

  .toc-item {
    flex: 1;
    text-align: center;
    padding: 12px 6px;
    font-size: 13px;
    color: #888;
    font-weight: 500;
    border-right: 1px solid #eee;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s;
    line-height: 1.3;
  }

  .toc-item:last-child { border-right: none; }
  .toc-item:hover { background: #f5f4f0; color: #333; }

  .page-rule {
    max-width: 960px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    color: #aaa;
    font-size: 13px;
  }

  .page-rule::before, .page-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #ddd;
  }

  /* ── 반응형 ── */
  @media (max-width: 680px) {
    .cols2, .cols3, .two-col { grid-template-columns: 1fr; }
    .page-body { padding: 32px 24px 36px; }
    .page-header { padding: 14px 24px; }
    .slide-title { font-size: 28px; }
    .toc-item { font-size: 11px; padding: 10px 4px; }
  }
</style>
</head>
