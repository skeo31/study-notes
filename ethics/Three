  --txt:#e7e9ee; --muted:#9aa3b2; --accent:#6ea8fe; --accent2:#7c5cff;
  --ok:#46c08a; --bad:#ef6a6a; --warn:#e0b341; --ppt:#7c5cff; --lec:#2f9e8f;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--txt);font-family:'Pretendard','Noto Sans KR',-apple-system,BlinkMacSystemFont,'Malgun Gothic',sans-serif;line-height:1.6}
.wrap{max-width:880px;margin:0 auto;padding:18px 16px 80px}
header{position:sticky;top:0;z-index:20;background:linear-gradient(180deg,rgba(15,17,21,.98),rgba(15,17,21,.92));backdrop-filter:blur(6px);padding:14px 0 10px;border-bottom:1px solid var(--line)}
h1{font-size:20px;margin:0 0 4px;font-weight:800;letter-spacing:-.3px}
.sub{color:var(--muted);font-size:12.5px;margin:0}
.note{background:var(--panel2);border:1px solid var(--line);border-left:3px solid var(--warn);border-radius:8px;padding:9px 12px;margin:12px 0;font-size:12.5px;color:#d7d2b8}
.sets{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0 4px}
.setbtn{background:var(--panel);border:1px solid var(--line);color:var(--muted);border-radius:8px;padding:7px 0;font-size:13px;cursor:pointer;font-weight:700;width:calc(20% - 5px);text-align:center;transition:.12s}
.setbtn:hover{border-color:var(--accent)}
.setbtn.active{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border-color:transparent}
.setbtn .pdone{display:block;font-size:9.5px;font-weight:600;opacity:.85}
.bar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:10px 0}
.btn{background:var(--panel);border:1px solid var(--line);color:var(--txt);border-radius:9px;padding:9px 14px;font-size:13.5px;cursor:pointer;font-weight:700;transition:.12s}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:linear-gradient(135deg,var(--accent),var(--accent2));border-color:transparent;color:#fff}
.btn.ghost{background:transparent}
.score{margin-left:auto;font-weight:800;font-size:14px}
.q{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 15px;margin:11px 0}
.qhead{display:flex;align-items:center;gap:7px;margin-bottom:8px;flex-wrap:wrap}
.qnum{font-weight:800;font-size:14px;color:var(--accent)}
.badge{font-size:10.5px;font-weight:700;padding:2px 7px;border-radius:20px;border:1px solid var(--line)}
.b-ppt{background:rgba(124,92,255,.14);color:#b3a0ff;border-color:transparent}
.b-lec{background:rgba(47,158,143,.16);color:#6fd6c6;border-color:transparent}
.b-type{background:var(--panel2);color:var(--muted)}
.qtext{font-size:15px;font-weight:600;margin:2px 0 10px;white-space:pre-wrap}
.opts{display:flex;flex-direction:column;gap:7px}
.opt{display:flex;gap:9px;align-items:flex-start;background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:9px 11px;cursor:pointer;font-size:14px;transition:.1s}
.opt:hover{border-color:var(--accent)}
.opt input{margin-top:3px;accent-color:var(--accent);flex:none}
.opt.correct{border-color:var(--ok);background:rgba(70,192,138,.12)}
.opt.wrong{border-color:var(--bad);background:rgba(239,106,106,.12)}
.opt .onum{font-weight:700;color:var(--muted);flex:none}
.fillin{width:100%;background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:10px 12px;color:var(--txt);font-size:14px;font-family:inherit}
.fillin.correct{border-color:var(--ok)}
.fillin.wrong{border-color:var(--bad)}
.expl{display:none;margin-top:10px;padding:10px 12px;background:var(--panel2);border:1px solid var(--line);border-left:3px solid var(--ok);border-radius:8px;font-size:13px;color:#cfe9dd}
.expl.show{display:block}
.expl b{color:var(--ok)}
.essay{background:linear-gradient(180deg,var(--panel),#15171f);border:1px solid var(--line);border-radius:12px;padding:15px;margin:11px 0}
.essay .qtext{color:#ffd98a}
.essay textarea{width:100%;min-height:90px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:10px 12px;color:var(--txt);font-size:14px;font-family:inherit;resize:vertical;margin-top:6px}
.model{display:none;margin-top:10px;padding:11px 13px;background:rgba(124,92,255,.10);border:1px solid var(--line);border-left:3px solid var(--accent2);border-radius:8px;font-size:13.5px;white-space:pre-wrap;line-height:1.7}
.model.show{display:block}
.model b{color:#b3a0ff}
.footnote{color:var(--muted);font-size:11.5px;text-align:center;margin-top:24px}
.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--accent2);color:#fff;padding:11px 18px;border-radius:30px;font-weight:700;font-size:13.5px;opacity:0;pointer-events:none;transition:.25s;z-index:50}
.toast.show{opacity:1}
@media(max-width:520px){.setbtn{width:calc(25% - 5px)}.score{width:100%;margin:6px 0 0}}
</style>

<div class="wrap">
  <header>
    <h1>🏆 도전 500제 · 정보사회와 사이버 윤리</h1>
    <p class="sub">3회독 — 기출형 모의고사 · 26문제 × 20세트 (객관식·단답 24 + 서술형 2)</p>
  </header>

  <div class="note">
    ※ <b>PPT 내용 우선(1순위)</b>·강의 내용(2순위)로 구성 · <b>공리주의·칸트 의무론은 출제 제외</b>(강의 미포함) · 보라색=PPT, 청록색=강의/사이버윤리
  </div>

  <div class="sets" id="sets"></div>

  <div class="bar">
    <button class="btn primary" id="grade">📝 채점하기</button>
    <button class="btn" id="reveal">정답·해설 보기</button>
    <button class="btn ghost" id="reset">다시 풀기</button>
    <span class="score" id="score"></span>
  </div>

  <div id="quiz"></div>

  <div class="bar" style="justify-content:center;margin-top:20px">
    <button class="btn" id="prev">← 이전 세트</button>
    <button class="btn primary" id="next">다음 세트 →</button>
  </div>

  <p class="footnote">총 192개 객관식/단답 + 19개 서술형 문제은행에서 세트별로 고루 출제됩니다. · 정보사회와 사이버 윤리 기말 대비</p>
</div>
<div class="toast" id="toast"></div>

<script>
// ===== 세트 구성 =====
const PPT_PARTS=["AI기초","AI이론","AI한계","자율주행","윤리인증","AI노동사회"];
const PER_SET=[ // [part, 문항수]  PPT 13 + 강의 11 = 24
 ["AI기초",2],["AI이론",3],["AI한계",1],["자율주행",2],["윤리인증",3],["AI노동사회",2],
 ["정보사회",2],["윤리학기초",1],["덕윤리",3],["익명성",1],["사이버범죄",1],["사이버윤리실천",3]
];
const NSETS=20;
function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function shuffle(arr,rnd){const a=arr.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(rnd()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}

// 파트별 인덱스 풀(섞기) + 회전 포인터
const rnd=mulberry32(20260616);
const poolByPart={};
PER_SET.forEach(([p])=>{poolByPart[p]=shuffle(BANK.map((q,i)=>({q,i})).filter(o=>o.q.p===p),rnd)});
const essayPool=shuffle(ESSAYS.map((e,i)=>({e,i})),rnd);

const SETS=[];
const ptr={}; PER_SET.forEach(([p])=>ptr[p]=0); let eptr=0;
for(let s=0;s<NSETS;s++){
  const objs=[];
  PER_SET.forEach(([p,n])=>{
    const pool=poolByPart[p];
    for(let k=0;k<n;k++){objs.push(pool[ptr[p]%pool.length].q);ptr[p]++}
  });
  const ess=[];
  for(let k=0;k<2;k++){ess.push(essayPool[eptr%essayPool.length].e);eptr++}
  SETS.push({objs,ess});
}

// ===== 상태 =====
let cur=0;
const answers={}; // answers[set] = {qi:value}
for(let s=0;s<NSETS;s++)answers[s]={};
const done=new Array(NSETS).fill(false);

// ===== 렌더 =====
const setsEl=document.getElementById('sets');
function renderSets(){
  setsEl.innerHTML='';
  for(let s=0;s<NSETS;s++){
    const b=document.createElement('button');
    b.className='setbtn'+(s===cur?' active':'');
    b.innerHTML=(s+1)+'세트'+(done[s]?'<span class="pdone">✔ 완료</span>':'<span class="pdone">&nbsp;</span>');
    b.onclick=()=>{cur=s;render()};
    setsEl.appendChild(b);
  }
}
const quiz=document.getElementById('quiz');
function partBadge(p){const ppt=PPT_PARTS.includes(p);return '<span class="badge '+(ppt?'b-ppt':'b-lec')+'">'+p+'</span>'}
function typeLabel(t){return t==='mc'?'5지선다':t==='tf'?'참/거짓':'빈칸단답'}
function render(){
  renderSets();
  const set=SETS[cur];const a=answers[cur];
  let html='';
  set.objs.forEach((q,qi)=>{
    html+='<div class="q" data-qi="'+qi+'">';
    html+='<div class="qhead"><span class="qnum">'+(qi+1)+'.</span>'+partBadge(q.p)+'<span class="badge b-type">'+typeLabel(q.t)+'</span></div>';
    html+='<div class="qtext">'+q.q+'</div>';
    if(q.t==='mc'){
      html+='<div class="opts">';
      q.o.forEach((opt,oi)=>{
        const ck=a[qi]===oi?'checked':'';
        html+='<label class="opt" data-oi="'+oi+'"><input type="radio" name="q'+qi+'" value="'+oi+'" '+ck+'><span class="onum">'+'①②③④⑤'[oi]+'</span><span>'+opt+'</span></label>';
      });
      html+='</div>';
    } else if(q.t==='tf'){
      ['참','거짓'].forEach((opt,oi)=>{
        const val=oi===0; const ck=a[qi]===val?'checked':'';
        html+='<label class="opt" data-tf="'+val+'"><input type="radio" name="q'+qi+'" value="'+val+'" '+ck+'><span class="onum">'+(oi===0?'O':'X')+'</span><span>'+opt+'</span></label>';
      });
    } else { // fill
      const v=a[qi]!=null?a[qi]:'';
      html+='<input class="fillin" type="text" placeholder="정답 입력" value="'+String(v).replace(/"/g,'&quot;')+'" data-fill="'+qi+'">';
    }
    html+='<div class="expl" data-expl="'+qi+'"><b>정답:</b> '+answerText(q)+'<br>'+q.e+'</div>';
    html+='</div>';
  });
  // 서술형
  set.ess.forEach((e,ei)=>{
    html+='<div class="essay"><div class="qhead"><span class="qnum">'+(25+ei)+'.</span>'+partBadge(e.p)+'<span class="badge b-type">서술형·10점</span></div>';
    html+='<div class="qtext">'+e.q+'</div>';
    html+='<textarea placeholder="여기에 답안을 작성해 보세요" data-essay="'+ei+'">'+(a['e'+ei]||'')+'</textarea>';
    html+='<div style="margin-top:8px"><button class="btn ghost modelbtn" data-mi="'+ei+'">모범답안 보기</button></div>';
    html+='<div class="model" data-model="'+ei+'"><b>모범답안</b><br>'+e.model+'</div></div>';
  });
  quiz.innerHTML=html;
  bind();
  document.getElementById('score').textContent=done[cur]?scoreText():'';
  window.scrollTo({top:0,behavior:'smooth'});
}
function answerText(q){if(q.t==='mc')return '①②③④⑤'[q.a]+' '+q.o[q.a];if(q.t==='tf')return q.a?'참(O)':'거짓(X)';return q.a}
function bind(){
  quiz.querySelectorAll('input[type=radio]').forEach(r=>r.addEventListener('change',e=>{
    const qi=+e.target.closest('.q').dataset.qi;
    let v=e.target.value; if(v==='true')v=true;else if(v==='false')v=false;else v=+v;
    answers[cur][qi]=v;
  }));
  quiz.querySelectorAll('input[data-fill]').forEach(inp=>inp.addEventListener('input',e=>{
    answers[cur][+e.target.dataset.fill]=e.target.value;
  }));
  quiz.querySelectorAll('textarea[data-essay]').forEach(t=>t.addEventListener('input',e=>{
    answers[cur]['e'+e.target.dataset.essay]=e.target.value;
  }));
  quiz.querySelectorAll('.modelbtn').forEach(b=>b.onclick=()=>{
    quiz.querySelector('[data-model="'+b.dataset.mi+'"]').classList.toggle('show');
  });
}
function norm(s){return String(s||'').replace(/\s|[()·,.'"’‘]/g,'').toLowerCase()}
function gradeOne(q,val){
  if(val==null||val==='')return null;
  if(q.t==='fill')return norm(val)===norm(q.a)||norm(q.a).includes(norm(val))&&norm(val).length>=2;
  return val===q.a;
}
function scoreText(){
  const set=SETS[cur];const a=answers[cur];let ok=0;
  set.objs.forEach((q,qi)=>{if(gradeOne(q,a[qi])===true)ok++});
  return '객관식·단답 '+ok+' / 24  (정답률 '+Math.round(ok/24*100)+'%)';
}
function grade(){
  const set=SETS[cur];const a=answers[cur];
  set.objs.forEach((q,qi)=>{
    const el=quiz.querySelector('.q[data-qi="'+qi+'"]');
    const res=gradeOne(q,a[qi]);
    if(q.t==='fill'){
      const inp=el.querySelector('.fillin');inp.classList.remove('correct','wrong');
      if(res===true)inp.classList.add('correct');else if(res===false)inp.classList.add('wrong');
    } else {
      el.querySelectorAll('.opt').forEach(o=>{o.classList.remove('correct','wrong');
        const oi=q.t==='mc'?+o.dataset.oi:(o.dataset.tf==='true');
        if(oi===q.a)o.classList.add('correct');
        if(a[qi]===oi&&oi!==q.a)o.classList.add('wrong');
      });
    }
    el.querySelector('[data-expl="'+qi+'"]').classList.add('show');
  });
  done[cur]=true;
  document.getElementById('score').textContent=scoreText();
  renderSets();
  toast('채점 완료! '+scoreText());
}
function reveal(){
  quiz.querySelectorAll('.expl').forEach(e=>e.classList.add('show'));
  quiz.querySelectorAll('.model').forEach(e=>e.classList.add('show'));
  // 정답 표시
  SETS[cur].objs.forEach((q,qi)=>{
    const el=quiz.querySelector('.q[data-qi="'+qi+'"]');
    if(q.t!=='fill')el.querySelectorAll('.opt').forEach(o=>{const oi=q.t==='mc'?+o.dataset.oi:(o.dataset.tf==='true');if(oi===q.a)o.classList.add('correct')});
    else el.querySelector('.fillin').classList.add('correct');
  });
}
function reset(){answers[cur]={};done[cur]=false;render();toast('이 세트를 초기화했습니다')}
let tt;function toast(m){const el=document.getElementById('toast');el.textContent=m;el.classList.add('show');clearTimeout(tt);tt=setTimeout(()=>el.classList.remove('show'),2200)}

document.getElementById('grade').onclick=grade;
document.getElementById('reveal').onclick=reveal;
document.getElementById('reset').onclick=reset;
document.getElementById('prev').onclick=()=>{if(cur>0){cur--;render()}};
document.getElementById('next').onclick=()=>{if(cur<NSETS-1){cur++;render()}};
render();
</script>
</body></html>
